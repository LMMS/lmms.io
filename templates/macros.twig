{# Creates a small Jumbo header; pass heading = false when the page content has its own h1 #}
{% macro jumbo(title, subtitle, heading = true) %}
<div class="jumbotron mini">
	<div class="container">
		{% if heading %}<h1>{{title}}</h1>{% else %}<p class="h2">{{title}}</p>{% endif %}
		<p class="h5">{{subtitle}}</p>
	</div>
</div>
{% endmacro %}

{# Prints an icon stack: an inversed icon on top of a background shape, with a tooltip that also labels it #}
{% macro icon_stack(background, icon, class, tooltip) %}
	<span class='icon-stack {{ class }}'{% if tooltip %} data-tooltip='{{ tooltip }}'{% endif %}>
		{{ ux_icon(background) }}
		{{ ux_icon(icon, {class: 'icon icon-stack-inner'}) }}
		{% if tooltip %}<span class='visually-hidden'>{{ tooltip }}</span>{% endif %}
	</span>
{% endmacro %}

{# Prints an icon stack with the lower one being a circle #}
{% macro circle_stack(icon, class = '', tooltip = '') %}
	{% import _self as macros %}
	{{ macros.icon_stack('fa6-solid:circle', icon, class, tooltip) }}
{% endmacro %}

{# Prints an icon stack with the lower one being a square #}
{% macro square_stack(icon, class = '', tooltip = '') %}
	{% import _self as macros %}
	{{ macros.icon_stack('fa6-solid:square', icon, class, tooltip) }}
{% endmacro %}

{% macro create_artwork_item(artwork_name, img_path, raw_path, rendered_path, author_name = '', author_link = '', modified_by = '') %}
	{% import _self as macros %}
	<img class="art-thumb" src="{{img_path}}">
	<h2 class="h3">{{artwork_name}}</h2>
	{% set buttons = [raw_path, rendered_path] %}
	{% if author_name %}
		<p><strong>{% trans %}Author:{% endtrans %} </strong><a href="{{author_link}}">{{author_name}}</a><br>
	{% else %}
		<p>
	{% endif %}
	{% if modified_by %}
		<strong>{% trans %}Modified/Themed By:{% endtrans %} </strong>{{modified_by}}</p>
	{% else %}
		</p>
	{% endif %}
	{% for button in buttons %}
		{% if button %}
			{% set file_name = button|split('/')|last %}
			{% set extension = file_name|split('.')|last %}
			<a target="_blank" class="btn btn-default" href="{{button}}" download>
				{{ ux_icon('fa6-solid:image') }} {{file_name}} <br><small>({{macros.get_file_description(extension)|trim}})</small>
			</a>&nbsp; 
		{% endif %}
	{% endfor %}
	<br><br><hr><br><br>
{% endmacro %}

{% macro get_file_description(extension) %}
	{% set descriptions = {
		'svg' : 'Scalable Vector Format'|trans,
		'png' : 'PNG Format'|trans,
		'xcf' : 'Gimp Image Editor Format'|trans,
		'pdf' : 'Portable Document Format'|trans,
		'psd' : 'Adobe Photoshop Format'|trans,
		'png' : 'PNG Format'|trans,
		'jpg' : 'JPEG Format'|trans,
		'jpeg': 'JPEG Format'|trans,
		'bmp' : 'Bitmap Format'|trans,
		'ico' : 'Windows Icon Format'|trans,
		'icns': 'Apple Icon Format'|trans,
		} 
	%}
	{{descriptions[extension]|default("Unknown File")}}
{% endmacro %}

{% macro print_menu_item(class, text, url, icon = null) %}
	<li class='{{class}}'><a class='dropdown-item' href='{{url}}'>
	{% if icon %}
		{{ ux_icon(icon, {class: 'icon icon-fw'}) }}
	{% endif %}
	{{text}}
	</a></li>
{% endmacro %}

{% macro create_navbar_menu_item(text, url, children = null, rightAlign = false, active = '') %}
	{% import _self as macros %}
	{% if children is null %}
	{# Simple menu item. If $text is an array, $text[0] is the title displayed
		on big screens, $text[1] is the one displayed on smaller screens #}
		{% if text is iterable %}
			<li class="nav-item d-none d-xl-block"> <a class="nav-link {{active}}" href="{{url}}">{{text[0]}}</a></li>
			<li class="nav-item d-xl-none"> <a class="nav-link {{active}}" href="{{url}}">{{text[1]}}</a></li>
		{% else %}
			<li class="nav-item"> <a class="nav-link {{active}}" href="{{url}}">{{text}}</a></li>
		{% endif %}
	{% else %}
	{# Drop-down items: opened on hover on big screens, on click on small ones #}
		<li class='nav-item dropdown d-none d-md-block'>
			<a href='#' class='nav-link dropdown-toggle'>{{text}}</a>
			<ul class='dropdown-menu'>
				{% for key, child in children %}
					{{macros.print_menu_item('', child[1], child[2], child[0])}}
				{% endfor %}
			</ul>
		</li>
		<li class='nav-item dropdown d-md-none'>
			<a href='#' class='nav-link dropdown-toggle {{active}}' role='button' data-disclosure aria-controls='navbar-more' aria-expanded='false'>{{text}}</a>
			<ul class="dropdown-menu" id="navbar-more">
				{% for child in children %}
					{{macros.print_menu_item('', child[1], child[2], child[0])}}
				{% endfor %}
			</ul>
		</li>
	{% endif %}
{% endmacro %}

{% macro create_navbar(items, current_uri = '/') %}
	{% import _self as macros %}
	{% for item in items %}
		{% if not item[3] is defined %}
			{% set active = item[1] == current_uri ? 'active' : '' %}
			{{macros.create_navbar_menu_item(item[0], item[1], item[2]|default(null), false, active)}}
		{% endif %}
	{% endfor %}
	</ul>
	<ul class="navbar-nav ms-auto">
	{% for item in items %}
		{% if item[3] is defined %}
			{{macros.create_navbar_menu_item(item[0], item[1], item[2]|default(null), true)}}
		{% endif %}
	{% endfor %}
{% endmacro %}
