{% import 'navbar.twig' as nav %}
{% import 'macros.twig' as macros %}
{% set uri = app.request.pathinfo %}
<!DOCTYPE HTML>
<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}LMMS | {{ nav.get_active_title(uri)|trim }}{% endblock %}</title>

    <meta name="description" content="LMMS is a free, open source, multiplatform digital audio workstation.">
    <link rel="icon" type="image/png" href="/img/logo_sm.png">
    <script>
        // Follow the OS color scheme for Bootstrap components
        (function () {
            var dark = window.matchMedia('(prefers-color-scheme: dark)');
            var apply = function () {
                document.documentElement.dataset.bsTheme = dark.matches ? 'dark' : 'light';
            };
            apply();
            dark.addEventListener('change', apply);
        })();
    </script>
    {% block stylesheets %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;700&amp;family=Orbitron:wght@500&amp;family=Titillium+Web:wght@400;600&amp;display=swap" rel="stylesheet">
    {% endblock %}
    {% block importmap %}{{ importmap('app') }}{% endblock %}
</head>

<body role="document">
    <nav class="navbar navbar-expand-md navbar-custom fixed-top">
        <div class="container">
            <a class="navbar-brand" href="/"><img alt="LMMS Logo" class="logo-sm float-start" height="22" width="22" src="/img/brand-icon.png">LMMS</a>
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#navbar" aria-controls="navbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbar">
                <ul class="navbar-nav">
                    {{ nav.build_navbar(uri) }}
                </ul>
            </div>
        </div>
    </nav>

    {% block header %}{% endblock %}
    <div class="theme-showcase main-div" role="main" dir="auto">
        {% block content %}{% endblock %}
    </div>

    <footer id="footer">
        <div class="container">
            <div class="row justify-content-center justify-content-md-end">
                <div class="col-auto px-0 column-md-6">
                    <a class="social" href="https://github.com/LMMS">{{ macros.square_stack('fa6-brands:github', 'icon-4x') }}</a>
                    <a class="social" href="https://facebook.com/makefreemusic">{{ macros.square_stack('fa6-brands:facebook', 'icon-4x') }}</a>
                    <a class="social" href="https://twitter.com/lmmsio">{{ macros.square_stack('fa6-brands:x-twitter', 'icon-4x') }}</a>
                    <a class="social" href="/chat">{{ macros.square_stack('fa6-brands:discord', 'icon-4x') }}</a>
                    <a class="social" href="https://lmms.bandcamp.com">{{ macros.square_stack('fa6-brands:bandcamp', 'icon-4x') }}</a>
                    <a class="social" href="https://www.youtube.com/user/LMMSOfficial">{{ macros.square_stack('fa6-brands:youtube', 'icon-4x') }}</a>
                </div>
            </div>
        </div>
    </footer>

    {% block foot %}{% endblock %}
</body>
</html>
