{% import 'navbar.twig' as nav %}
{% import 'macros.twig' as macros %}
{% set uri = app.request.pathinfo %}
<!DOCTYPE HTML>
<html lang="{{ app.request.locale|replace({'_': '-'}) }}">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}LMMS | {{ nav.get_active_title(uri)|trim }}{% endblock %}</title>

    <meta name="description" content="LMMS is a free, open source, multiplatform digital audio workstation.">
    <link rel="icon" type="image/png" href="/img/logo_sm.png">
    <script>
        // Follow the OS color scheme unless the theme toggle saved a choice. Runs inline so
        // the page never flashes the other theme.
        {
            const dark = matchMedia('(prefers-color-scheme: dark)');
            const apply = () => {
                let theme;
                try {
                    theme = localStorage.getItem('theme');
                } catch {}
                if (!['light', 'dark'].includes(theme)) {
                    theme = dark.matches ? 'dark' : 'light';
                }
                document.documentElement.dataset.theme = theme;
            };
            apply();
            dark.addEventListener('change', apply);
            // a toggle in another tab
            addEventListener('storage', apply);
        }
    </script>
    {% block stylesheets %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;700&amp;family=Orbitron:wght@500&amp;family=Titillium+Web:wght@400;600&amp;display=swap" rel="stylesheet">
    {% endblock %}
    {% block importmap %}{{ importmap('app') }}{% endblock %}
    {# without JS: show the language list, hide the theme toggle #}
    <noscript><style>
        .locale-switcher .dropdown-menu { position: static; display: block; }
        .theme-toggle { display: none; }
    </style></noscript>
</head>

<body role="document">
    <nav class="navbar-custom fixed-top">
        <div class="container">
            <a class="navbar-brand" href="/"><img alt="LMMS Logo" class="logo-sm float-start" height="22" width="22" src="/img/brand-icon.png">LMMS</a>
            <button type="button" class="navbar-toggler" data-disclosure aria-controls="navbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
            </button>

            <div class="navbar-collapse" id="navbar">
                <div class="navbar-collapse-inner">
                    <ul class="navbar-nav">
                        {{ nav.build_navbar(uri) }}
                        {% include 'theme_toggle.twig' %}
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    {% block header %}{% endblock %}
    <div class="theme-showcase main-div" role="main" dir="auto">
        {% block content %}{% endblock %}
    </div>

    <footer id="footer">
        <div class="container">
            <div class="row align-items-center justify-content-center justify-content-md-between">
                <div class="col-auto order-last order-md-first">
                    {% include 'locale_switcher.twig' %}
                </div>
                <div class="col-auto px-0 column-md-6">
                    <a class="social" href="https://github.com/LMMS">{{ macros.square_stack('fa6-brands:github', 'icon-4x') }}</a>
                    <a class="social" href="https://facebook.com/makefreemusic">{{ macros.square_stack('fa6-brands:facebook', 'icon-4x') }}</a>
                    <a class="social" href="https://twitter.com/lmmsio">{{ macros.square_stack('fa6-brands:x-twitter', 'icon-4x') }}</a>
                    <a class="social" href="/chat">{{ macros.square_stack('fa6-brands:discord', 'icon-4x') }}</a>
                    <a class="social" href="https://lmms.bandcamp.com">{{ macros.square_stack('fa6-brands:bandcamp', 'icon-4x') }}</a>
                    <a class="social" href="https://www.youtube.com/user/LMMSOfficial">{{ macros.square_stack('fa6-brands:youtube', 'icon-4x') }}</a>
                </div>
            </div>
        </div>
    </footer>

    {% block foot %}{% endblock %}
</body>
</html>
