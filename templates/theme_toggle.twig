{# The label names the theme a click switches to; CSS shows the one for the current theme #}
<li class="nav-item">
    <button type="button" class="nav-link theme-toggle">
        <span class="theme-toggle-dark">{{ ux_icon('fa6-solid:moon', {class: 'icon icon-fw'}) }} <span class="theme-toggle-label">{{ 'Dark theme'|trans }}</span></span>
        <span class="theme-toggle-light">{{ ux_icon('fa6-solid:sun', {class: 'icon icon-fw'}) }} <span class="theme-toggle-label">{{ 'Light theme'|trans }}</span></span>
    </button>
</li>
