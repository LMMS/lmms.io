{% extends 'lsp/base.twig' %}

{% block title %}LMMS | Sign up{% endblock %}

{% block lsp_layout %}
<div class="container lsp-auth">
    <div class="lsp-panel lsp-form">
        <h1 class="lsp-title">Join the community</h1>
        <p class="text-body-secondary">Create an account to upload, rate and comment.</p>
        {% if error %}
            <div class="alert alert-danger lsp-alert">{{ ux_icon('lucide:circle-alert') }}<span><strong>Error:</strong> {{ error|raw }}</span></div>
        {% endif %}
        <form action="{{ path('lsp_register') }}" method="post">
            <div class="mb-3">
                <label class="form-label" for="realname">Display name</label>
                <input type="text" id="realname" name="realname" class="form-control" maxlength="50" required autocomplete="name">
            </div>
            <div class="mb-3">
                <label class="form-label" for="login">Username</label>
                <input type="text" id="login" name="login" class="form-control" maxlength="16" required autocomplete="username">
                <div class="form-text">Up to 16 characters. It cannot be changed later.</div>
            </div>
            <div class="row gy-3 mb-3">
                <div class="col-sm-6">
                    <label class="form-label" for="password">Password</label>
                    <input type="password" id="password" name="password" class="form-control" maxlength="20" required autocomplete="new-password">
                </div>
                <div class="col-sm-6">
                    <label class="form-label" for="password2">Confirm password</label>
                    <input type="password" id="password2" name="password2" class="form-control" maxlength="20" required autocomplete="new-password">
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label" for="captcha">Security code</label>
                <div class="lsp-captcha">
                    <img src="{{ path('lsp_captcha') }}" alt="Security code" width="96" height="48">
                    <input type="text" id="captcha" name="captcha" class="form-control" maxlength="6" placeholder="Type the code" required autocomplete="off">
                </div>
            </div>
            <button type="submit" class="btn btn-lsp w-100" name="adduser" value="Register">Create account</button>
        </form>
        <p class="lsp-auth-switch">Already have an account? <a href="{{ path('lsp_login') }}">Log in</a></p>
    </div>
</div>
{% endblock %}
