{% extends 'lsp/base.twig' %}

{% import 'lsp/macros.twig' as lsp %}

{% block main_content %}
    {{ lsp.heading('Settings', []) }}
    {% if error %}
        <div class="alert alert-danger lsp-alert">{{ ux_icon('lucide:circle-alert') }}<span><strong>Error:</strong> {{ error }}</span></div>
    {% endif %}
    <form class="lsp-panel lsp-form" action="{{ path('lsp_settings') }}" method="post">
        <div class="lsp-form-file">
            <div>
                <strong>@{{ username }}</strong>
                <span class="text-body-secondary d-block">Usernames cannot be changed</span>
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label" for="realname">Display name</label>
            <input type="text" id="realname" name="realname" class="form-control" maxlength="50" value="{{ realname }}">
        </div>
        <fieldset>
            <legend class="lsp-legend">Change password</legend>
            <div class="row g-3">
                <div class="col-sm-6">
                    <label class="form-label" for="password">New password</label>
                    <input type="password" id="password" name="password" maxlength="20" class="form-control" autocomplete="new-password">
                </div>
                <div class="col-sm-6">
                    <label class="form-label" for="password2">Confirm new password</label>
                    <input type="password" id="password2" name="password2" maxlength="20" class="form-control" autocomplete="new-password">
                </div>
            </div>
            <p class="form-text">Leave empty to keep your current password.</p>
        </fieldset>
        <div class="lsp-form-actions">
            <a href="/lsp" class="btn btn-outline-secondary">Cancel</a>
            <button class="btn btn-lsp" type="submit" name="settings" value="apply">Save</button>
        </div>
    </form>
{% endblock %}
