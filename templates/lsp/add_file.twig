{% extends 'lsp/base.twig' %}

{% import 'lsp/macros.twig' as lsp %}

{% block main_content %}
    {{ lsp.heading('Upload your work', []) }}
    {{ lsp.content_warning() }}
    <form class="lsp-panel lsp-form" enctype="multipart/form-data" action="{{ path('lsp_add') }}" method="post">
        <label class="lsp-drop">
            {{ ux_icon('lucide:cloud-upload', {class: 'icon lsp-drop-icon'}) }}
            <span class="lsp-drop-title" id="file-selected">Click to choose a file, or drop it here</span>
            <span class="lsp-drop-hint">Projects (.mmp, .mmpz), presets (.xpf), samples (.wav, .ogg, .flac…), themes and screenshots · max 2 MB</span>
            <input type="file" name="filename" required>
        </label>
        <div class="form-check mt-3">
            <input class="form-check-input" type="checkbox" id="nocopyright" name="nocopyright" required>
            <label class="form-check-label" for="nocopyright">This upload does not violate any existing copyright, law or trademark</label>
        </div>
        <div class="lsp-form-actions">
            <a href="/lsp" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" name="ok" value="OK" class="btn btn-lsp">Continue</button>
        </div>
    </form>
{% endblock %}
