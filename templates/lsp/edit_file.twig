{% extends 'lsp/base.twig' %}

{% import 'lsp/macros.twig' as lsp %}

{% block main_content %}
    {% if tmpname %}
        {{ lsp.heading('Describe your upload', [['Upload', path('lsp_add')]]) }}
    {% else %}
        {{ lsp.heading('Edit ' ~ fn|lsp_stem, [[fn, path('lsp_show', {id: file_id})]]) }}
    {% endif %}
    <form class="lsp-panel lsp-form" enctype="multipart/form-data" action="{{ form_action }}" method="post">
        <div class="lsp-form-file">
            <span class="lsp-ext">{{ fn|lsp_ext }}</span>
            <div>
                <strong class="text-break">{{ fn }}</strong>
                {% if fsize %}<span class="text-body-secondary d-block">{{ fsize|lsp_size }}</span>{% endif %}
            </div>
        </div>
        <div class="row g-3">
            <div class="col-sm-6">
                <label class="form-label" for="category">Category</label>
                <select id="category" name="category" class="form-select">
                {% for cat in categories %}
                    <option{% if cat.value == selected_category %} selected{% endif %}>{{ cat.value }}</option>
                {% endfor %}
                </select>
            </div>
            <div class="col-sm-6">
                <label class="form-label" for="license">License</label>
                <select id="license" name="license" class="form-select">
                {% for lic in licenses %}
                    <option{% if lic == selected_license or (selected_license is empty and loop.first) %} selected{% endif %}>{{ lic }}</option>
                {% endfor %}
                </select>
            </div>
            <div class="col-12">
                <label class="form-label" for="description">Description</label>
                <textarea id="description" rows="10" name="description" class="form-control" placeholder="Tell people about it: how you made it, what's inside, which samples or presets you used… Links to YouTube, SoundCloud and clyp.it become players.">{{ description }}</textarea>
            </div>
        </div>
        <div class="lsp-form-actions">
            {% if tmpname %}
                <a href="/lsp" class="btn btn-outline-secondary">Cancel</a>
                <button class="btn btn-lsp" type="submit" name="addfinalok" value="Add File">{{ ux_icon('lucide:upload') }}&nbsp; Publish</button>
            {% else %}
                <a href="{{ path('lsp_show', {id: file_id}) }}" class="btn btn-outline-secondary">Cancel</a>
                <button class="btn btn-lsp" type="submit" name="updateok" value="OK">Save changes</button>
            {% endif %}
        </div>
        <input type="hidden" name="fn" value="{{ fn }}">
        {% if tmpname %}
            <input type="hidden" name="tmpname" value="{{ tmpname }}">
            <input type="hidden" name="fsize" value="{{ fsize }}">
            <input type="hidden" name="nocopyright" value="{{ nocopyright }}">
        {% else %}
            <input type="hidden" name="action" value="update">
        {% endif %}
    </form>
{% endblock %}
