{% extends 'lsp/base.twig' %}

{% import 'lsp/macros.twig' as lsp %}

{% set rs = rows|first %}

{% block title %}LMMS | {{ rs ? rs.filename : 'File not found' }}{% endblock %}

{% block main_content %}
    {% if not rs %}
        {{ lsp.heading('File not found', []) }}
        <div class="alert alert-danger lsp-alert">
            {{ ux_icon('lucide:circle-alert') }}
            <span><strong>Error:</strong> File not found! It may have been deleted by its author.</span>
        </div>
    {% else %}
        {% set can_edit = is_admin or username == rs.login %}
        {% set can_rate = username and username != rs.login %}

        {{ lsp.crumbs([
            [rs.category, '/lsp?action=browse&category=' ~ rs.category|escape('url')],
            [rs.subcategory, '/lsp?action=browse&category=' ~ rs.category|escape('url') ~ '&subcategory=' ~ rs.subcategory|escape('url')],
        ]) }}
        <article class="lsp-entry">
            <header class="lsp-entry-head">
                <div>
                    <h1 class="lsp-title" title="{{ rs.filename }}">{{ rs.filename|lsp_stem }}</h1>
                    <div class="lsp-post-meta">
                        {# the sidebar box names the uploader where it sits beside the post #}
                        <span class="lsp-entry-author">
                            {{ lsp.user_link(rs.login, rs.realname) }}
                            <span class="text-body-secondary">@{{ rs.login }}</span>
                            <span class="lsp-dot" aria-hidden="true">·</span>
                        </span>
                        {{ lsp.time(rs.insert_date) }}
                        {% if rs.update_date and rs.update_date != rs.insert_date %}
                            <span class="lsp-dot" aria-hidden="true">·</span>
                            <span class="text-body-secondary">edited {{ lsp.time(rs.update_date) }}</span>
                        {% endif %}
                    </div>
                </div>
            </header>

            {% if rs.thumb %}
                <a class="lsp-entry-image" href="{{ path('lsp_download', {id: rs.id}) }}"><img src="{{ rs.thumb }}" alt="Preview of {{ rs.filename }}"></a>
            {% endif %}

            <div id="desc" class="lsp-entry-desc">
                {% if rs.description %}
                    {{ rs.description|nl2br }}
                {% else %}
                    <p class="text-body-secondary fst-italic">No description provided.</p>
                {% endif %}
            </div>

            <div class="lsp-entry-actions">
                <a class="btn btn-lsp" href="{{ path('lsp_download', {id: rs.id}) }}">{{ ux_icon('lucide:download') }}&nbsp; Download <span class="lsp-btn-note">{{ rs.size|lsp_size }}</span></a>
                {% set captions = ['Rate this', 'Poor', 'Fair', 'Good', 'Great', 'Excellent'] %}
                <div class="lsp-action lsp-rate{{ can_rate ? '' : ' disabled' }}" {% if not can_rate %}title="{{ username ? 'You cannot rate your own upload' : 'Log in to rate' }}"{% endif %}>
                    <span class="lsp-stars">
                    {# Reversed so that hovering a star can highlight its preceding siblings via ~ #}
                    {% for i in 5..1 %}
                        {% set star %}<span class="lsp-star{{ i <= rs.session_rating ? ' filled' : '' }}">{{ ux_icon('lucide:star', {class: 'icon star-full'}) }}{{ ux_icon('lucide:star', {class: 'icon star-empty'}) }}</span>{% endset %}
                        {% if can_rate %}
                            <a href="{{ path('lsp_rate', {id: rs.id, stars: i}) }}" title="{{ captions[i] }}" rel="nofollow">{{ star }}</a>
                        {% else %}
                            <span>{{ star }}</span>
                        {% endif %}
                    {% endfor %}
                    </span>
                    <span class="lsp-rate-caption">{{ rs.session_rating ? 'You rated: ' ~ captions[rs.session_rating] : (can_rate ? 'Rate this' : '') }}</span>
                </div>
                <a class="lsp-action" href="#comments">{{ ux_icon('lucide:message-circle') }} {{ rs.comment_section|length }}</a>
                {% if can_edit %}
                    <span class="lsp-entry-owner">
                        <a class="lsp-action" href="{{ path('lsp_edit', {id: rs.id}) }}">{{ ux_icon('lucide:pencil') }} Edit</a>
                        <a class="lsp-action lsp-action-danger" href="{{ path('lsp_delete', {id: rs.id}) }}">{{ ux_icon('lucide:trash-2') }} Delete</a>
                    </span>
                {% endif %}
            </div>
        </article>

        <section class="lsp-discussion" id="comments" aria-labelledby="comments-title">
            <h2 class="lsp-section-title" id="comments-title">{{ rs.comment_section|length }} {{ rs.comment_section|length == 1 ? 'comment' : 'comments' }}</h2>

            {# One field at rest; focusing it opens the full box with its buttons #}
            {% if username %}
                <form class="lsp-reply" action="{{ path('lsp_comment', {id: rs.id}) }}" method="post">
                    <textarea name="text" rows="1" required placeholder="Add a comment" aria-label="Your comment"></textarea>
                    <div class="lsp-reply-actions">
                        <button type="reset" class="lsp-action">Cancel</button>
                        <button type="submit" class="btn btn-lsp btn-sm" name="addcomment" value="Comment">Comment</button>
                    </div>
                </form>
            {% else %}
                <div class="lsp-reply lsp-reply-guest">
                    <a href="{{ path('lsp_login') }}">Log in to add a comment</a>
                    <a class="lsp-reply-signup" href="{{ path('lsp_register') }}">Sign up</a>
                </div>
            {% endif %}

            <ol class="lsp-comments">
                {% for comment in rs.comment_section %}
                    <li class="lsp-comment">
                        <div class="lsp-comment-body">
                            <div class="lsp-post-meta">
                                {{ lsp.user_link(comment.login, comment.realname) }}
                                {% if comment.commentuser == comment.fileuser %}
                                    <span class="lsp-badge-author" title="Uploaded this file">Author</span>
                                {% endif %}
                                <span class="lsp-dot" aria-hidden="true">·</span>
                                {{ lsp.time(comment.date) }}
                            </div>
                            <div class="lsp-comment-text">{{ comment.text|nl2br }}</div>
                        </div>
                    </li>
                {% else %}
                    <li class="lsp-comments-empty text-body-secondary">No comments yet. Be the first to share your thoughts!</li>
                {% endfor %}
            </ol>
        </section>
    {% endif %}
{% endblock %}

{% block lsp_aside %}
    {% if rs %}
        <div class="lsp-box">
            <section class="lsp-uploader">
                <h2 class="lsp-panel-title">Uploaded by</h2>
                <div>
                    <strong>{{ rs.realname ?: rs.login }}</strong>
                    <a href="/lsp?action=browse&amp;user={{ rs.login|escape('url') }}">See all uploads by @{{ rs.login }}</a>
                </div>
            </section>
            <section>
                <h2 class="lsp-panel-title">About this file</h2>
                <dl class="lsp-facts">
                    <dt>{{ ux_icon('lucide:file', {class: 'icon icon-fw'}) }} File</dt>
                    <dd class="text-break">{{ rs.filename }}</dd>
                    <dt>{{ ux_icon('lucide:hard-drive', {class: 'icon icon-fw'}) }} Size</dt>
                    <dd>{{ rs.size|lsp_size }}</dd>
                    <dt>{{ ux_icon('lucide:scale', {class: 'icon icon-fw'}) }} License</dt>
                    <dd>{{ rs.license }}</dd>
                    {% if rs.lmms_version %}
                        <dt>{{ ux_icon('lucide:git-branch', {class: 'icon icon-fw'}) }} LMMS</dt>
                        <dd>{{ rs.lmms_version }}</dd>
                    {% endif %}
                    <dt>{{ ux_icon('lucide:download', {class: 'icon icon-fw'}) }} Downloads</dt>
                    <dd>{{ rs.downloads }}</dd>
                    <dt>{{ ux_icon('lucide:star', {class: 'icon icon-fw'}) }} Rating</dt>
                    <dd>{{ rs.rating_count ? rs.rating|number_format(1) ~ ' / 5 (' ~ rs.rating_count ~ (rs.rating_count == 1 ? ' vote)' : ' votes)') : 'Not rated yet' }}</dd>
                    <dt>{{ ux_icon('lucide:calendar', {class: 'icon icon-fw'}) }} Uploaded</dt>
                    <dd>{{ rs.insert_date|date('M j, Y') }}</dd>
                </dl>
            </section>
        </div>
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block foot %}
<script defer src="https://cdn.jsdelivr.net/npm/linkifyjs@4.4.0/dist/linkify.min.js" integrity="sha384-ratS1OgyDbYKZHPKvQ+McGITjqyef6xrsPVkh97mB8fEZzcqlT9VheSWLACU6x0z" crossorigin="anonymous"></script>
<script defer src="https://cdn.jsdelivr.net/npm/linkify-element@4.4.0/dist/linkify-element.min.js" integrity="sha384-wEFOKx8J/xs3hA0qNiXy3R36x3aJb6DdRzHpH8N0/iAUERvHeyJowhtJVX2j0UcL" crossorigin="anonymous"></script>
<script>
    // Swap a description link to YouTube, SoundCloud or Clyp for an embedded player
    const replaceFrames = (element) => {
        const { hostname, pathname } = element;
        const params = new URLSearchParams(element.search);
        let src = null;
        if (hostname.includes('youtube.com') && pathname === '/watch' && params.get('v')?.length > 4) {
            src = `https://www.youtube.com/embed/${params.get('v')}`;
        } else if (hostname.includes('youtu.be') && pathname.length > 4) {
            src = `https://www.youtube.com/embed/${pathname.substring(1)}`;
        } else if (hostname.includes('soundcloud.com')) {
            // SoundCloud hands out its own embed code
            const url = element.getAttribute('href');
            fetch(`https://soundcloud.com/oembed?${new URLSearchParams({ format: 'json', url })}`)
                .then((response) => response.json())
                .then((data) => {
                    if (data.html) {
                        const embed = document.createElement('div');
                        embed.innerHTML = data.html;
                        embed.setAttribute('height', '160');
                        element.replaceWith(embed);
                    }
                });
        } else if (hostname.includes('clyp.it')) {
            src = `https://clyp.it${pathname}/widget`;
        }
        if (src) {
            const frame = document.createElement('iframe');
            frame.setAttribute('src', src);
            frame.setAttribute('frameborder', 0);
            frame.setAttribute('width', '100%');
            frame.setAttribute('height', '160');
            element.replaceWith(frame);
        }
    };
    document.addEventListener('DOMContentLoaded', () => {
        const desc = document.getElementById('desc');
        if (desc) {
            linkifyElement(desc, { className: 'linkified', target: { url: '_blank' } });
        }
        // comments get clickable links, only the description gets players
        document.querySelectorAll('.lsp-comment-text').forEach((comment) => {
            linkifyElement(comment, { target: { url: '_blank' }, rel: 'nofollow ugc' });
        });
        document.querySelectorAll('.linkified').forEach(replaceFrames);
    });
</script>
{% endblock %}
