{% extends 'lsp/base.twig' %}

{% import 'lsp/macros.twig' as macros %}

{% block main_content %}
    <script defer src="https://cdn.jsdelivr.net/npm/linkifyjs@4.4.0/dist/linkify.min.js" integrity="sha384-ratS1OgyDbYKZHPKvQ+McGITjqyef6xrsPVkh97mB8fEZzcqlT9VheSWLACU6x0z" crossorigin="anonymous"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/linkify-element@4.4.0/dist/linkify-element.min.js" integrity="sha384-wEFOKx8J/xs3hA0qNiXy3R36x3aJb6DdRzHpH8N0/iAUERvHeyJowhtJVX2j0UcL" crossorigin="anonymous"></script>
    {% for rs in rows %}
        {{macros.make_title([rs['category'], rs['subcategory'], rs['filename']|escape])}}
        <table class="table table-striped">
            <td><div class="overflow-hidden">
            <small>by <a href="/lsp?action=browse&user={{rs['login']}}">
            {% if rs['realname'] %}
                {{rs['realname']}} ({{rs['login']}})
            {% else %}
                {{rs['login']}}
            {% endif %}
            </a></small><br>
            <b>Size:</b>&nbsp;{{(rs['size']/1024)|round(0)}} KB<br>
            <b>License:</b>&nbsp;{{rs['license']}}<br>
            {% if rs['lmms_version'] %}
                <b>LMMS Version:</b>&nbsp;{{rs['lmms_version']}}</div></td>
            {% endif %}
            {{macros.make_infobar(rs, true)}}
            <tr><td><strong>Name:</strong>&nbsp;{{rs['filename']}}
            {% if rs['thumb'] %}
                <br><br><a href="{{ path('lsp_download', {id: rs['id']}) }}"><img class="thumbnail" src="{{rs['thumb']}}" alt=""></a>
            {% endif %}
            </td><td class="lsp-file-info">
            <a href="{{ path('lsp_download', {id: rs['id']}) }}" id="downloadbtn" class="lsp-dl-btn btn btn-primary">
            <span class="fas fa-download lsp-download"></span>&nbsp;Download</a>
            </td></tr><tr><td colspan="2"><div class="well"><strong>Description:</strong><p id="desc">
            {% if rs['description'] %}
                {{rs['description']|nl2br}}
            {% else %}
                No description available.
            {% endif %}
            </p></div></td></tr>
            <tr><td colspan="2">
            <div id="lspnav" class="navbar navbar-default"><ul class="nav navbar-nav">
            {# Toolbar #}
                {% if username %}
                <li>
                    <a class="pull-left" href="/lsp/comment/{{rs['id']}}">
                {% else %}
                <li class="disabled">
                    <a class="pull-left" href="#" title="Login to comment">
                {% endif %}
                    <span class="fas fa-comment"></span>&nbsp;Comment</a>
                </li>
                {% set can_edit = is_admin or (username == rs['login']) %}
                {% if can_edit %}
                    {% set button_class = "" %}
                {% else %}
                    {% set button_class = "disabled" %}
                {% endif %}
                <li class="{{button_class}}"><a class="pull-left" href="/lsp/edit/{{rs['id']}}"><span class="fas fa-pencil-alt"></span>&nbsp;Edit</a></li>
                <li class="{{button_class}}"><a class="pull-left" href="/lsp/delete/{{rs['id']}}"><span class="fas fa-trash"></span>&nbsp;Delete</a></li>
                {% set can_rate = username and username != rs['login'] %}
                {% set rating = rs['session_rating'] %}
                {% set captions = ['Not Rated', 'One Star', 'Two Stars', 'Three Stars', 'Four Stars', 'Five Stars'] %}
                {% set caption_classes = ['default', 'danger', 'warning', 'info', 'primary', 'success'] %}
                <li class="lsp-starrating">
                    <span class="lsp-stars{{ can_rate ? '' : ' disabled' }}">
                    {# Reversed so that hovering a star can highlight its preceding siblings via ~ #}
                    {% for i in 5..1 %}
                        {% if can_rate %}
                            <a href="{{ path('lsp_rate', {id: rs['id'], stars: i}) }}" title="{{ captions[i] }}" rel="nofollow"><span class="{{ i <= rating ? 'fas' : 'far' }} fa-star"></span></a>
                        {% else %}
                            <span><span class="{{ i <= rating ? 'fas' : 'far' }} fa-star"></span></span>
                        {% endif %}
                    {% endfor %}
                    </span>
                    <span class="label label-{{ caption_classes[rating] }}">{{ captions[rating] }}</span>
                </li>
            </div>
            <strong>Comments:</strong>
            </td></tr>
            {% for comment in rs['comment_section'] %}
                <tr><td colspan="2">
                <blockquote>
                {# Bold comments made by the original author #}
                {% if comment['commentuser'] == comment['fileuser'] %}
                    <strong>
                    {{comment['text']}}
                    </strong>
                {% else %}
                    {{comment['text']}}
                {% endif %}
                <small class="lsp-small">Posted by: 
                <a href="/lsp?action=browse&amp;user={{comment['login']}}">{{comment['login']}}</a>
                &nbsp;on {{comment['date']}}
                </small>
                </blockquote>
                </tr></td>
            {% else %}
                <td colspan="2"><p class="text-muted">No comments yet</p></td>
            {% endfor %}
        </table>
    {% else %}
        {{macros.make_title(['Error'])}}
        <div class="alert alert-danger text-center">
        <strong><span class="fas fa-exclamation-circle"></span>&nbsp;Error:
        </strong> File not found!
        </div>
    {% endfor %}
{% endblock %}

{% block foot %}
<script type="text/javascript">
    function get_search_params(search) {
        var params = search.substr(1).split('&');
        var kv = {};
        for (var i = 0; i < params.length; i++) {
            var pair = params[i].split('=');
            kv[decodeURIComponent(pair[0])] = pair[1];
        }
        return kv;
    }
    function replace_frames(element) {
        var url = element.getAttribute('href');
        var hostname = element.hostname;
        var frame = document.createElement('iframe');
        var params = get_search_params(element.search);
        if (hostname.includes('youtube.com') && element.pathname == '/watch' && params['v'] && params['v'].length > 4) {
            frame.setAttribute('src', 'https://www.youtube.com/embed/' + params['v']);
        } else if (hostname.includes('youtu.be') && element.pathname && element.pathname.length > 4) {
            frame.setAttribute('src', 'https://www.youtube.com/embed/' + element.pathname.substr(1));
        } else if (hostname.includes('soundcloud.com')) {
            frame = null; // don't create element this early
            // Fetch Soundcloud embed code
            fetch('https://soundcloud.com/oembed?' + new URLSearchParams({format: 'json', url: url}))
                .then(function(response) { return response.json(); })
                .then(function(data) {
                    if (data.html) {
                        var frame = document.createElement('div');
                        frame.innerHTML = data.html;
                        frame.setAttribute('height', '160');
                        element.parentNode.replaceChild(frame, element);
                    }
                });
        } else if (hostname.includes('clyp.it')) {
            frame.setAttribute('src', 'https://clyp.it' + element.pathname + '/widget');
        } else {
            frame = null;
        }
        if (frame) {
            frame.setAttribute('frameborder', 0);
            frame.setAttribute('width', '100%');
            frame.setAttribute('height', '160');
            element.parentNode.replaceChild(frame, element);
        }
    }
    document.addEventListener('DOMContentLoaded', function () {
        var desc = document.getElementById('desc');
        if (desc) {
            linkifyElement(desc, {className: 'linkified', target: {url: '_blank'}});
        }
        var links = document.querySelectorAll('.linkified');
        for (var i = 0; i < links.length; i++) {
            var element = links[i];
            replace_frames(element);
        }
    });
</script>
{% endblock %}