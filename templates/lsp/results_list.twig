{% extends 'lsp/base.twig' %}

{% import 'lsp/macros.twig' as macros %}

{% macro is_sort_active(column) %}
    {{ app.request.query.get('sort') == column ? 'active' : '' }}
{% endmacro %}

{% macro sort_order(column) %}
    {% if app.request.query.get('sort') == column %}
        {% if app.request.query.get('order') == 'asc' %}
            ({{ ux_icon('fa6-solid:arrow-up-long') }})
        {% else %}
            ({{ ux_icon('fa6-solid:arrow-down-long') }})
        {% endif %}
    {% endif %}
{% endmacro %}

{% macro sort_url(column) %}
    {% set queries = app.request.query %}
    {% if app.request.query.get('sort') == column %}
        {% if app.request.query.get('order') == 'asc' %}
            {% set queries = queries|merge({'order': ''}) %}
        {% else %}
            {% set queries = queries|merge({'order': 'asc'}) %}
        {% endif %}
    {% endif %}
    {% set queries = queries|merge({'sort': column}) %}
    /lsp?{{ queries|map((v, k) => "#{k}=#{v|escape('url')}")|join("&") }}
{% endmacro %}

{% macro paginate_url(page) %}
    {% set queries = app.request.query|merge({'page': page - 1}) %}
    /lsp?{{ queries|map((v, k) => "#{k}=#{v|escape('url')}")|join("&") }}
{% endmacro %}

{% block main_content %}
    {% import _self as r_macros %}
    {{macros.make_title(titles)}}
    <table class="table table-striped">
    <ul class="nav nav-pills lsp-sort">
        <li id="sort-date" class="nav-item">
            <a class="nav-link {{ r_macros.is_sort_active('date')|trim }}" href="{{ r_macros.sort_url('date') }}">{{ ux_icon('fa6-solid:calendar') }}&nbsp;DATE {{ r_macros.sort_order('date') }}</a>
        </li>
        <li id="sort-downloads" class="nav-item">
            <a class="nav-link {{ r_macros.is_sort_active('downloads')|trim }}" href="{{ r_macros.sort_url('downloads') }}">{{ ux_icon('fa6-solid:download') }}&nbsp;DOWNLOADS / AGE {{ r_macros.sort_order('downloads') }}</a>
        </li>
        <li id="sort-rating" class="nav-item">
            <a class="nav-link {{ r_macros.is_sort_active('rating')|trim }}" href="{{ r_macros.sort_url('rating') }}">{{ ux_icon('fa6-solid:star') }}&nbsp;RATING {{ r_macros.sort_order('rating') }}</a>
        </li>
    </ul>
        {% for rs in rows %}
            {{macros.make_item(rs, sort)}}
        {% else %}
            <div class="alert alert-info text-center">
            <strong>{{ ux_icon('fa6-solid:circle-info') }}&nbsp;</strong> No results found
            </div>
        {% endfor %}
    </table>
    {% if count > 25 %}
    {% set pages = count / 25.0 %}
    {% set current_page = app.request.query.get('page', 0) + 1 %}
    <div class="text-center">
        <div class="lsp-pagination center">
            <ul class="pagination justify-content-center flex-wrap">
                {% for i in 1..pages|round(0, 'ceil') %}
                <li class="page-item {{ i == current_page ? 'active' : '' }}"><a class="page-link" href="{{r_macros.paginate_url(i)}}">{{i}}</a></li>
                {% endfor %}
            </ul>
        </div>
    </div>
    {% endif %}
{% endblock %}
