{% extends 'lsp/base.twig' %}

{% import 'lsp/macros.twig' as lsp %}

{% set subcategory = subcategory ?? '' %}
{% set active_category = category_list|filter(c => c.active)|first %}
{% set home_active = search == '' and browse_user == '' and category == '' %}

{# The current listing's URL with some query parameters changed; empty values are dropped #}
{% macro list_url(changes) %}/lsp?{{ app.request.query.all|merge(changes)|filter(v => v is not same as(null) and v != '')|url_encode }}{% endmacro %}

{% block title %}LMMS | {{ search ? 'Search: ' ~ search : (browse_user ?: (subcategory ?: (category ?: 'Sharing Platform'))) }}{% endblock %}

{% block main_content %}
    {% import _self as r %}

    {% set noun = search ? ['result', 'results'] : ['upload', 'uploads'] %}
    {% set tally = count|number_format ~ ' ' ~ (count == 1 ? noun[0] : noun[1]) %}
    {% if search %}
        {% set title = 'Results for "' ~ search ~ '"' %}
        {% set crumbs = category ? [[category, active_category.url ?? '']] : [] %}
    {% elseif browse_user %}
        {% set title = (rows|first).realname ?? browse_user %}
        {% set tally = '@' ~ browse_user ~ ' · ' ~ tally %}
        {% set crumbs = [] %}
    {% else %}
        {% set title = subcategory ?: (category ?: 'All uploads') %}
        {% set crumbs = subcategory ? [[category, active_category.url ?? '']] : [] %}
    {% endif %}

    {# The sidebar already says where a top-level listing is; a trail only helps one level down #}
    {% if crumbs %}{{ lsp.crumbs(crumbs) }}{% endif %}
    <div class="lsp-feed-head">
        <div class="lsp-feed-title">
            <h1 class="lsp-title">{{ title }}</h1>
            <span class="lsp-feed-tally">{{ tally }}</span>
        </div>
        <nav class="lsp-sort" aria-label="Sort by">
            {% for key, label in {date: 'New', downloads: 'Popular', rating: 'Top rated'} %}
                <a class="lsp-sort-link{{ sort == key ? ' active' : '' }}" href="{{ r.list_url({sort: key, order: null, page: null}) }}"{% if sort == key %} aria-current="true"{% endif %}>{{ label }}</a>
            {% endfor %}
        </nav>
    </div>

    {% if search %}
        <form class="lsp-filter" action="/lsp" method="get">
            <input type="hidden" name="search" value="{{ search }}">
            {% if category %}<input type="hidden" name="category" value="{{ category }}">{% endif %}
            {% if subcategory %}<input type="hidden" name="subcategory" value="{{ subcategory }}">{% endif %}
            <input type="hidden" name="sort" value="{{ sort }}">
            <label class="form-check-label">
                <input class="form-check-input" type="checkbox" name="commentsearch" value="1" {{ commentsearch ? 'checked' }} data-autosubmit>
                Also search in comments
            </label>
            <noscript><button class="btn btn-sm btn-outline-secondary" type="submit">Apply</button></noscript>
        </form>
    {% endif %}

    {% if active_category and active_category.subcategories %}
        <nav class="lsp-chips" aria-label="Subcategories">
            <a class="lsp-chip-link{{ subcategory == '' ? ' active' : '' }}" href="{{ active_category.url }}">All</a>
            {% for sub in active_category.subcategories|filter(s => s.count > 0 or s.active) %}
                <a class="lsp-chip-link{{ sub.active ? ' active' : '' }}" href="{{ sub.url }}">{{ sub.name }} <span class="lsp-count">{{ sub.count }}</span></a>
            {% endfor %}
        </nav>
    {% endif %}

    <div class="lsp-feed">
        {% for rs in rows %}
            {{ lsp.post_card(rs, category == '', subcategory == '', browse_user == '') }}
        {% else %}
            <div class="lsp-empty">
                {{ ux_icon('lucide:search', {class: 'icon lsp-empty-icon'}) }}
                <p><strong>Nothing here yet.</strong></p>
                <p class="text-body-secondary">{{ search ? 'Try a different search term.' : 'Be the first to share something!' }}</p>
                <a class="btn btn-lsp" href="{{ path('lsp_add') }}">{{ ux_icon('lucide:upload') }}&nbsp; Upload</a>
            </div>
        {% endfor %}
    </div>

    {% set pages = (count / page_size)|round(0, 'ceil') %}
    {% if pages > 1 %}
        {% set current = page + 1 %}
        <nav class="lsp-pages" aria-label="Pages">
            {% if current > 1 %}
                <a class="lsp-page" href="{{ r.list_url({page: current - 2 ?: null}) }}" rel="prev">{{ ux_icon('lucide:arrow-left') }}<span class="visually-hidden">Previous</span></a>
            {% endif %}
            {% for i in 1..pages %}
                {% if i == 1 or i == pages or (i - current)|abs <= 2 %}
                    <a class="lsp-page{{ i == current ? ' active' : '' }}" href="{{ r.list_url({page: i - 1 ?: null}) }}"{% if i == current %} aria-current="page"{% endif %}>{{ i }}</a>
                {% elseif (i - current)|abs == 3 %}
                    <span class="lsp-page-gap">…</span>
                {% endif %}
            {% endfor %}
            {% if current < pages %}
                <a class="lsp-page" href="{{ r.list_url({page: current}) }}" rel="next">Next</a>
            {% endif %}
        </nav>
    {% endif %}
{% endblock %}
