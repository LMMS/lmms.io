{% extends 'lsp/base.twig' %}

{% import 'lsp/macros.twig' as macros %}

{% block main_content %}
    {{macros.make_title(titles)}}
    {% if error %}
    <div class="alert alert-danger text-center">
    <strong>{{ ux_icon('fa6-solid:circle-exclamation') }}&nbsp;
    Error:</strong> {{error}}
    </div>
    {% else %}
    <div class="alert alert-warning text-center">
    <strong>{{ ux_icon('fa6-solid:circle-exclamation') }}&nbsp;
    Warning:</strong> Do not submit offending, pornographic, racist or violent content.
    </div>
    {% endif %}
    <div class="card"><div class="card-header"><h3 class="card-title">{{ ux_icon('fa6-solid:comment') }}&nbsp;Comment</h3></div><div class="card-body">
        <form action="/lsp/comment/{{file_id}}" method="post">
        <div class="form-group">
		<label for="text">Add comment to "{{file_name}}"</label>
		<textarea id="comment" name="text" class="form-control"></textarea>
		</div>
		<button type="submit" class="btn btn-primary" name="addcomment" value="Comment">{{ ux_icon('fa6-solid:check') }}&nbsp;Comment</button>&nbsp;
		<a href="/lsp/{{file_id}}" class="btn btn-warning">{{ ux_icon('fa6-solid:xmark') }}&nbsp;Cancel</a>
		</form></div>
    </div>
{% endblock %}
