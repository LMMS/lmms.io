{% extends 'lsp/base.twig' %}

{% import 'lsp/macros.twig' as lsp %}

{% block main_content %}
    {{ lsp.heading('Add a comment', [[file_name, path('lsp_show', {id: file_id})]]) }}
    {% if error %}
        <div class="alert alert-danger lsp-alert">{{ ux_icon('lucide:circle-alert') }}<span><strong>Error:</strong> {{ error }}</span></div>
    {% endif %}
    <form class="lsp-panel lsp-form" action="{{ path('lsp_comment', {id: file_id}) }}" method="post">
        <div class="mb-3">
            <label class="form-label" for="comment">Your comment on “{{ file_name }}”</label>
            <textarea id="comment" name="text" class="form-control" rows="5" required autofocus placeholder="Share your thoughts or feedback…"></textarea>
        </div>
        <div class="lsp-form-actions">
            <a href="{{ path('lsp_show', {id: file_id}) }}" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn btn-lsp" name="addcomment" value="Comment">Comment</button>
        </div>
    </form>
{% endblock %}
