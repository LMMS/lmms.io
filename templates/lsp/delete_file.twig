{% extends 'lsp/base.twig' %}

{% import 'lsp/macros.twig' as lsp %}

{% block main_content %}
    {{ lsp.heading('Delete ' ~ file_name|lsp_stem ~ '?', [[file_name, path('lsp_show', {id: file_id})]]) }}
    <form class="lsp-panel lsp-form" action="{{ path('lsp_delete', {id: file_id}) }}" method="post">
        <input type="hidden" name="confirmation" value="true">
        <p class="mb-1">You are about to permanently delete <strong class="text-break">{{ file_name }}</strong>.</p>
        <p class="text-body-secondary">All of its comments and ratings will be deleted too. This cannot be undone.</p>
        <div class="lsp-form-actions">
            <a class="btn btn-outline-secondary" href="{{ path('lsp_show', {id: file_id}) }}">Cancel</a>
            <button type="submit" class="btn btn-danger">{{ ux_icon('lucide:trash-2') }}&nbsp; Delete forever</button>
        </div>
    </form>
{% endblock %}
