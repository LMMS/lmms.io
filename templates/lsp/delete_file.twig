{% extends 'lsp/base.twig' %}

{% import 'lsp/macros.twig' as macros %}

{% block main_content %}
    {{macros.make_title([file_name, 'Delete'])}}
    <div class="alert alert-warning text-center"><strong>{{ ux_icon('fa6-solid:circle-exclamation') }}&nbsp;
            Warning:
        </strong> This will also delete all the comments and ratings.
    </div>
    <div class="card"><div class="card-header"><h3 class="card-title">{{ ux_icon('fa6-solid:trash') }}&nbsp;Confirm Delete</h3></div>
    <div class="card-body">
    <form action="/lsp/delete/{{file_id}}" method="post">
		<input type="hidden" name="confirmation" value="true">
		<p class="lead">Confirm deletion of <strong>{{file_name}}</strong>?</p>
		<div class="form-group">
    <button type="submit" class="btn btn-danger">
		{{ ux_icon('fa6-solid:check') }}&nbsp;Delete</button>
		<a class="btn btn-warning" href="/lsp/{{file_id}}">
		{{ ux_icon('fa6-solid:xmark') }}&nbsp;Cancel</a>
		</div></form></div>
    </div>
{% endblock %}
