# editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[{compose.yaml,compose.*.yaml}]
indent_size = 2

# Mixed indentation turns Markdown blocks into code blocks
[templates/competitions.twig]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
