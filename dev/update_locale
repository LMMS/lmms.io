#!/bin/bash
# Sync every translations/messages.*.xlf with the keys used in templates and code
srctop=$(realpath "$(dirname "$0")"/../)

for f in "${srctop}/translations/"messages.*.xlf
do
    locale="$(basename "$f")"
    locale="${locale/.xlf/}"
    locale="${locale/messages./}"
    "${srctop}/bin/console" translation:extract --force --clean --prefix='' -- "$locale"
done
